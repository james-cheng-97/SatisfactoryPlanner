<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Satisfactory Planner</AssemblyTitle>
    <Product>Satisfactory Planner</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release  →  one self-contained exe (no .NET install needed); data, icons and names are inside it -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Build flavours (dotnet publish -c Release [-p:Flavor=Full]):
       Standard (default): the app + the blueprint writer script and templates. Game data comes from the wiki on first
         start; the writer's library is installed with npm on the first blueprint export (needs Node.js + network).
       Full: everything bundled for offline use — game data / icons / names (Data/), the writer's library and a
         portable node.exe (from NodeDir, default the build machine's Node.js install). No network, no Node.js needed. -->
  <PropertyGroup>
    <Flavor Condition="'$(Flavor)' == ''">Standard</Flavor>
    <NodeDir Condition="'$(NodeDir)' == ''">$(ProgramFiles)\nodejs</NodeDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- the blueprint writer: always -->
    <None Update="bp\write.js;bp\templates.json;bp\package.json;bp\package-lock.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(Flavor)' == 'Full'">
    <None Update="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data\images\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="bp\node_modules\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NodeDir)\node.exe" Link="bp\node\node.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NodeDir)\LICENSE" Link="bp\node\LICENSE" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NodeDir)\LICENSE')" />
    <None Update="bp\node-NOTICE.txt" Link="bp\node\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- a fresh clone has no bp/node_modules (not in Git): restore the blueprint writer's library with npm. Without
       npm the app still builds; only "Export blueprints" can't run until `npm ci` is done in bp/ -->
  <Target Name="RestoreBlueprintWriter" BeforeTargets="BeforeBuild" Condition="!Exists('bp/node_modules/@etothepii/satisfactory-file-parser')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="bp" ContinueOnError="true" />
    <Warning Condition="!Exists('bp/node_modules/@etothepii/satisfactory-file-parser')" Text="bp/node_modules missing: run 'npm ci' in bp/ (needs Node.js) so Export blueprints works." />
  </Target>
</Project>
